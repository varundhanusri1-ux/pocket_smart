# =============================================================================
# PocketSmart AI — Environment Configuration
# Copy this file to `.env` and fill in your real values. Never commit `.env`.
# =============================================================================

# --- Google Gemini (https://aistudio.google.com/apikey) ---
# Your Gemini API key. The app starts without it, but AI features fall back
# to clearly-labelled demo recommendations until a valid key is provided.
GEMINI_API_KEY=
# Any current Gemini model that supports generateContent, e.g.
# gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash
# Timeout (seconds) for Gemini API calls
GEMINI_TIMEOUT_SECONDS=45

# --- Security ---
# Long random string used to sign JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-long-random-string
# JWT signing algorithm
JWT_ALGORITHM=HS256
# Minutes until an access token expires
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
# SQLite by default; any SQLAlchemy URL works (e.g. postgresql+psycopg://...)
DATABASE_URL=sqlite:///./pocketsmart.db

# --- App ---
DEBUG=false
# Comma-separated list of allowed CORS origins (frontend origins only)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Jewelry planner image upload limits ---
MAX_IMAGE_SIZE_MB=5
# Comma-separated allowed MIME types
ALLOWED_IMAGE_TYPES=image/png,image/jpeg,image/jpg,image/webp
